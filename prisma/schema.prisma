generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeamVisibility {
  PUBLIC
  MEMBERS
  ADMIN
}

model User {
  id        String  @id @default(uuid())
  name      String
  email     String  @unique
  password  String?
  avatarUrl String?

  isActive Boolean @default(true)

  isManager Boolean @default(false)

  teams                UserTeam[]
  accounts             OAuthAccount[]
  joinRequests         JoinRequest[]
  teamCreationRequests TeamCreationRequest[]

  matchesCreated      Match[]                @relation("MatchCreatedBy")
  matchesUpdated      Match[]                @relation("MatchUpdatedBy")
  presencesCreated    Presence[]             @relation("PresenceCreatedBy")
  presencesUpdated    Presence[]             @relation("PresenceUpdatedBy")
  goalsCreated        Goal[]                 @relation("GoalCreatedBy")
  goalsUpdated        Goal[]                 @relation("GoalUpdatedBy")
  transactionsCreated FinancialTransaction[] @relation("FinancialTransactionCreatedBy")
  transactionsUpdated FinancialTransaction[] @relation("FinancialTransactionUpdatedBy")

  lastTeamId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id   String @id @default(uuid())
  name String
  slug String @unique

  visibility TeamVisibility @default(PUBLIC)
  isActive Boolean @default(true)

  // Habilitado somente pelo usuário MASTER (manager) no painel /admin
  financeEnabled Boolean @default(false)

  logo           String? @db.Text
  primaryColor   String?
  secondaryColor String?

  users        UserTeam[]
  players      Player[]
  matches      Match[]
  seasons      Season[]
  joinRequests JoinRequest[]
  transactions FinancialTransaction[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model UserTeam {
  id     String   @id @default(uuid())
  userId String
  teamId String
  role   TeamRole @default(MEMBER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  lastAccessedAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model OAuthAccount {
  id     String @id @default(uuid())
  userId String

  provider          OAuthProvider
  providerAccountId String

  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model JoinRequest {
  id     String            @id @default(uuid())
  userId String
  teamId String
  status JoinRequestStatus @default(PENDING)
  role   TeamRole          @default(MEMBER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model Player {
  id     String @id @default(uuid())
  teamId String

  name      String
  nickname  String?
  positions String[] @default([])
  number    Int?
  photo    String? @db.Text
  active   Boolean @default(true)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  goals     Goal[]
  assists   Goal[]     @relation("AssistantRelation")
  presences Presence[]
  transactions FinancialTransaction[]

  seasonPlayers SeasonPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([name])
}

model SeasonPlayer {
  id        String   @id @default(cuid())
  seasonId  String
  playerId  String
  createdAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([seasonId, playerId])
  @@index([seasonId])
  @@index([playerId])
}

model Season {
  id        String   @id @default(cuid())
  teamId    String
  year      Int
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matches Match[]

  seasonPlayers SeasonPlayer[]
  transactions  FinancialTransaction[]

  @@unique([teamId, year])
  @@index([teamId])
}

model Match {
  id       String @id @default(uuid())
  teamId   String
  seasonId String

  date             DateTime
  location         String?
  opponent         String?
  competition      String?
  competitionPhase String?
  notes            String?

  ourScore   Int?
  theirScore Int?

  createdById String?
  updatedById String?

  team      Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season    Season @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("MatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("MatchUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  goals     Goal[]
  presences Presence[]
  transactions FinancialTransaction[]

  loanedPlayers String[] @default([])

  lineup Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, seasonId])
  @@index([seasonId])
  @@index([teamId])
  @@index([date])
  @@index([createdById])
  @@index([updatedById])
}

model Goal {
  id               String  @id @default(uuid())
  matchId          String
  playerId         String?
  loanedPlayerName String?

  assistantId         String?
  loanedAssistantName String?

  minute   Int?
  ownGoal  Boolean @default(false)
  freeKick Boolean @default(false)
  penalty  Boolean @default(false)

  createdById String?
  updatedById String?

  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  assistant Player? @relation("AssistantRelation", fields: [assistantId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("GoalUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchId])
  @@index([playerId])
  @@index([assistantId])
  @@index([createdById])
  @@index([updatedById])
}

model Presence {
  id       String @id @default(uuid())
  matchId  String
  playerId String

  present Boolean @default(true)

  createdById String?
  updatedById String?

  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("PresenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("PresenceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([playerId])
  @@index([createdById])
  @@index([updatedById])
}

enum TransactionType {
  INCOME
  EXPENSE
}

// Gestão financeira (admin only). Valores em centavos, sempre positivos; o sinal vem de `type`.
// Pagamento de jogador em um jogo = INCOME com matchId + playerId (1 por jogador por jogo,
// garantido por índice único parcial criado manualmente na migration).
model FinancialTransaction {
  id          String          @id @default(uuid())
  teamId      String
  seasonId    String
  type        TransactionType
  amountCents Int
  description String
  date        DateTime
  category    String?

  matchId     String?
  playerId    String?
  createdById String?
  updatedById String?

  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season    Season  @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  match     Match?  @relation(fields: [matchId], references: [id], onDelete: SetNull)
  player    Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("FinancialTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("FinancialTransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, seasonId, date])
  @@index([matchId])
  @@index([playerId])
  @@index([createdById])
  @@index([updatedById])
}

model TeamCreationRequest {
  id       String            @id @default(uuid())
  userId   String
  teamName String
  userName String
  phone    String
  email    String
  status   JoinRequestStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}




